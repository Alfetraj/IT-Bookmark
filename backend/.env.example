# Server Configuration
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Supabase (API / Storage)
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Connection (For pg-boss worker and raw SQL indexing)
# e.g., postgres://postgres.[project-id]:[password]@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=your_postgres_connection_string

# Authentication (JWT)
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret

# AI Tagging Providers (Vercel AI SDK)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Playwright Security / SSRF (Optional Network Bound)
# Comma-separated list of allowed internal IPs/hostnames if absolutely necessary
ALLOWED_INTERNAL_HOSTS=

# Storage Abstraction
STORAGE_PROVIDER=supabase # Options: supabase, local
LOCAL_STORAGE_PATH=./storage
